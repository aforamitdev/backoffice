{
	"$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
	"files": {
		"includes": ["src/**/*.{js,tsx,jsx,json,ts}"]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 5,
		"lineEnding": "lf",
		"lineWidth": 160,
		"attributePosition": "auto"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [["react", "react-dom"], ":BLANK_LINE:", ":PACKAGE:", ["@app", "@app/**"], ":BLANK_LINE:", ":PATH:"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "asNeeded",
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"bracketSameLine": false,
			"quoteStyle": "single",
			"attributePosition": "auto"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"useExhaustiveDependencies": "off",
				"noUnusedFunctionParameters": "error"
			},
			"a11y": {
				"useSemanticElements": "info"
			},
			"complexity": {
				"useOptionalChain": "off",
				"noUselessFragments": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	}
}
